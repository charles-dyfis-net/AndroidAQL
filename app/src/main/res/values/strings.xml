    <!-- Keep-Alive Strategy Copy -->
    <string name="dev_keep_alive_short_auto_offline_setup">Auto: One-Shot Offline 0x88 Setup + Passive (Default)</string>
    <string name="settings_keep_alive_desc_auto_offline_setup">Default: When the monitor is in 0x0A/0x8A Wi-Fi setup mode, performs a single ~5-second offline BLE setup (127.0.0.1 placeholder) to restore the normal anti-burn-in CO₂ OLED screen and transition into continuous 0x88 broadcasts, then listens 100% passively. For multi-hour trips, connect a USB-C power bank.</string>
    <string name="keep_alive_badge_auto_offline_setup">Auto (Offline 0x88 Setup)</string>

    <string name="dev_keep_alive_short_0509_24m_1101">Always 05 09 + 24m 11 01 Window Reset (Dev)</string>
    <string name="dev_settings_keep_alive_desc_0509_24m_1101">Developer diagnostic strategy: forces 24-minute 11 01 window resets everywhere to reset both the 10-minute and 30-minute BLE broadcast timers (switches the monitor OLED to the static Wi-Fi icon on each renewal).</string>
    <string name="dev_keep_alive_badge_0509_24m_1101">Dev 24m Reset (1101)</string>

    <string name="dev_keep_alive_short_0509_only">Always 05 09 Time Sync Only (&lt;30m Dev)</string>
    <string name="dev_settings_keep_alive_desc_0509_only">Developer diagnostic strategy: sends 05 09 RTC time sync every 3.5 minutes without changing the monitor OLED screen, reaching the 30-minute (29m 57s) BLE broadcast window ceiling.</string>
    <string name="dev_keep_alive_badge_0509_only">Dev 05 09 (&lt;30m)</string>

    <string name="dev_keep_alive_short_none_passive">Passive Only (No GATT Keep-Alive)</string>
    <string name="settings_keep_alive_desc_none_passive">Never initiates GATT connections. Recommended for custom BTHome v2 firmware, external hubs, or USB-powered operation without offline 0x88 setup.</string>
    <string name="keep_alive_badge_none_passive">Passive</string>


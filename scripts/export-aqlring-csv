#!/usr/bin/env python3
"""
Export a 26-column AirSlice CSV (matching docs/csv_export_schema.md) from an
`.aqlring` binary ring buffer and `android_aql_metadata.db` SQLite database.

Useful for converting pulled device backups (like `tmp/breakfast_trip/`) into
canned demo/replay CSVs under `app/src/main/assets/demo/`.
"""

from __future__ import annotations

import argparse
import csv
import datetime
import io
import sqlite3
import struct
from pathlib import Path
from typing import Any

HEADER_COLUMNS = [
    "timestamp_iso8601",
    "timestamp_epoch_sec",
    "resolution_sec",
    "sample_count",
    "device_mac",
    "device_nickname",
    "context_state",
    "known_place_label",
    "excursion_id",
    "excursion_title",
    "slice_id",
    "slice_label",
    "slice_notes",
    "co2_ppm_mean",
    "co2_ppm_min",
    "co2_ppm_max",
    "pm25_ugm3_mean",
    "pm25_ugm3_max",
    "pm10_ugm3_mean",
    "pm10_ugm3_max",
    "temp_c_mean",
    "humidity_pct_mean",
    "battery_pct",
    "rssi_dbm",
    "speed_mps",
    "gps_accuracy_m",
]

SENTINEL_UINT16 = 0xFFFF


def read_ring_slots(ring_path: Path) -> tuple[int, list[dict[str, Any]]]:
    data = ring_path.read_bytes()
    magic, ver, arch_count = struct.unpack_from("<8sII", data, 0)
    if magic != b"AQLRING1" or ver != 1 or arch_count < 1:
        raise ValueError(f"Unsupported .aqlring header in {ring_path}")
    step_sec, slot_count, slot_size, data_offset, _last_bucket = struct.unpack_from("<IIIIQ", data, 64)
    slots: list[dict[str, Any]] = []
    for i in range(slot_count):
        off = data_offset + i * slot_size
        rec = struct.unpack_from("<IHHHHHHHHHHhBBHH", data, off)
        ts, cnt = rec[0], rec[1]
        if cnt > 0 and ts > 0:
            rssi = rec[13]
            if rssi >= 128:
                rssi -= 256
            slots.append(
                {
                    "bucket_epoch_sec": ts,
                    "sample_count": cnt,
                    "known_place_id": rec[2],
                    "co2_mean": rec[3],
                    "co2_min": rec[4],
                    "co2_max": rec[5],
                    "pm25_mean": rec[6] / 10.0,
                    "pm25_max": rec[7],
                    "pm10_mean": rec[8] / 10.0,
                    "pm10_max": rec[9],
                    "temp_c": rec[10] / 10.0,
                    "humidity": rec[11] / 10.0,
                    "battery": rec[12],
                    "rssi": rssi,
                    "speed_mps": None if rec[14] == SENTINEL_UINT16 else rec[14] / 100.0,
                    "gps_acc_m": None if rec[15] == SENTINEL_UINT16 else rec[15] / 10.0,
                }
            )
    slots.sort(key=lambda s: s["bucket_epoch_sec"])
    return step_sec, slots


def fmt_iso(epoch_sec: int, tz: datetime.tzinfo) -> str:
    return datetime.datetime.fromtimestamp(epoch_sec, tz=tz).isoformat()


def write_csv_rows(
    out_path: Path,
    rows: list[list[Any]],
) -> None:
    buf = io.StringIO()
    writer = csv.writer(buf, lineterminator="\n")
    writer.writerow(HEADER_COLUMNS)
    writer.writerows(rows)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(buf.getvalue(), encoding="utf-8")
    print(f"Wrote {len(rows)} rows to {out_path} ({out_path.stat().st_size:,} bytes)")


def main() -> int:
    parser = argparse.ArgumentParser(description="Export .aqlring + SQLite metadata to 26-column AirSlice CSV.")
    parser.add_argument("--ring", type=Path, required=True, help="Path to device_1.aqlring")
    parser.add_argument("--db", type=Path, required=True, help="Path to android_aql_metadata.db")
    parser.add_argument("--out", type=Path, required=True, help="Destination .csv path")
    parser.add_argument("--excursion-id", type=int, help="Excursion ID to export")
    parser.add_argument("--stationary-before-epoch", type=int, help="Export stationary slots before this epoch")
    parser.add_argument("--limit-slots", type=int, default=60, help="Max slots for --stationary-before-epoch")
    parser.add_argument("--excursion-title", help="Override excursion_title in CSV")
    parser.add_argument("--scrub-mac", default="58:2D:34:12:AB:CD", help="MAC address to write in CSV")
    parser.add_argument("--device-nickname", default="Qingping Air Monitor Lite", help="Device nickname in CSV")
    parser.add_argument("--place-label", default="Home", help="Known place label for stationary rows")
    args = parser.parse_args()

    step_sec, slots = read_ring_slots(args.ring)
    conn = sqlite3.connect(str(args.db))
    places = dict(conn.execute("SELECT id, label FROM known_place").fetchall())
    local_tz = datetime.datetime.now().astimezone().tzinfo or datetime.timezone.utc

    rows: list[list[Any]] = []
    if args.excursion_id is not None:
        exc_row = conn.execute(
            "SELECT id, start_epoch_sec, end_epoch_sec, title FROM excursion WHERE id = ?",
            (args.excursion_id,),
        ).fetchone()
        if not exc_row:
            raise SystemExit(f"Excursion {args.excursion_id} not found in {args.db}")
        exc_id, exc_start, exc_end, exc_title = exc_row
        if args.excursion_title:
            exc_title = args.excursion_title
        slices = conn.execute(
            "SELECT id, start_epoch_sec, end_epoch_sec, label, notes FROM session_slice "
            "WHERE excursion_id = ? ORDER BY start_epoch_sec ASC",
            (exc_id,),
        ).fetchall()
        end_bound = exc_end if exc_end is not None else (slots[-1]["bucket_epoch_sec"] if slots else exc_start)
        exc_slots = [s for s in slots if (exc_start // step_sec) * step_sec <= s["bucket_epoch_sec"] <= end_bound]

        for s in exc_slots:
            ts = s["bucket_epoch_sec"]
            matching_slice = next((sl for sl in slices if sl[1] <= ts <= sl[2]), None)
            if matching_slice is None and slices:
                matching_slice = slices[0] if ts < slices[0][1] else slices[-1]
            rows.append(
                [
                    fmt_iso(ts, local_tz),
                    ts,
                    step_sec,
                    s["sample_count"],
                    args.scrub_mac,
                    args.device_nickname,
                    "FIELD_EXCURSION",
                    "",
                    exc_id,
                    exc_title,
                    matching_slice[0] if matching_slice else "",
                    matching_slice[3] if matching_slice else "",
                    matching_slice[4] if matching_slice else "",
                    s["co2_mean"],
                    s["co2_min"],
                    s["co2_max"],
                    f"{s['pm25_mean']:.1f}",
                    s["pm25_max"],
                    f"{s['pm10_mean']:.1f}",
                    s["pm10_max"],
                    f"{s['temp_c']:.1f}",
                    f"{s['humidity']:.1f}",
                    s["battery"] if 0 <= s["battery"] <= 100 else "",
                    s["rssi"] if s["rssi"] > -128 else "",
                    f"{s['speed_mps']:.2f}" if s["speed_mps"] is not None else "",
                    f"{s['gps_acc_m']:.1f}" if s["gps_acc_m"] is not None else "",
                ]
            )
    elif args.stationary_before_epoch is not None:
        stat_slots = [s for s in slots if s["bucket_epoch_sec"] < args.stationary_before_epoch][-args.limit_slots :]
        for s in stat_slots:
            ts = s["bucket_epoch_sec"]
            label = places.get(s["known_place_id"], args.place_label)
            rows.append(
                [
                    fmt_iso(ts, local_tz),
                    ts,
                    step_sec,
                    s["sample_count"],
                    args.scrub_mac,
                    args.device_nickname,
                    "STATIONARY_KNOWN_AP",
                    label,
                    "",
                    "",
                    "",
                    "",
                    "",
                    s["co2_mean"],
                    s["co2_min"],
                    s["co2_max"],
                    f"{s['pm25_mean']:.1f}",
                    s["pm25_max"],
                    f"{s['pm10_mean']:.1f}",
                    s["pm10_max"],
                    f"{s['temp_c']:.1f}",
                    f"{s['humidity']:.1f}",
                    s["battery"] if 0 <= s["battery"] <= 100 else "",
                    s["rssi"] if s["rssi"] > -128 else "",
                    "",
                    "",
                ]
            )
    else:
        raise SystemExit("Specify --excursion-id or --stationary-before-epoch")

    write_csv_rows(args.out, rows)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
